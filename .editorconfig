root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
max_line_length = 110

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Prefer explicit types: this codebase is read far more often than written, and the domain leans on
# distinguishing types that look alike (PartialDate vs PartialPeriod, CodedConcept vs StagingMethod).
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern expression styles
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# Nullability is load-bearing here; a suppression should be a deliberate, visible act.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8625.severity = error

# EF Core scaffolds these. Treating them as generated keeps `dotnet ef migrations add` output
# building unmodified, so generated migrations never need hand-editing to satisfy style rules.
[**/Persistence/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
